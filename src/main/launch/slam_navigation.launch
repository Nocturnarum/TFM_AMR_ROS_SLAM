<launch>
  <!-- SLAM: gmapping construye el mapa mientras navega -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="/scan"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame"  value="map"/>
    <param name="maxUrange" value="8.0"/>
    <param name="maxRange"  value="12.0"/>
    <param name="delta"     value="0.05"/>
    <param name="particles" value="30"/>
    <param name="linearUpdate"  value="0.1"/>
    <param name="angularUpdate" value="0.2"/>
    <param name="map_update_interval" value="2.0"/>
  </node>

  <!-- Navegacion: publica en /cmd_vel_slam para entrar por main_node en modo AUTO -->
  <node pkg="move_base" type="move_base" name="move_base" respawn="false" output="screen">
    <rosparam file="$(find main)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find main)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find main)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find main)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find main)/config/dwa_local_planner_params.yaml" command="load"/>
    <rosparam file="$(find main)/config/move_base_params.yaml" command="load"/>
    <remap from="cmd_vel" to="/cmd_vel_slam"/>
  </node>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find main)/rviz/tfm_navigation.rviz"/>

  <!-- Control Adaptativo (Reconfiguracion) -->
  <node pkg="main" type="perfil_adaptativo" name="perfil_adaptativo" output="screen">
    <rosparam file="$(find main)/config/perfiles_navegacion.yaml" command="load"/>
  </node>
</launch>
